          "inset":        { "$value": "{color.neutral.950}", "$type": "color" },
          "vibrancy":     { "$value": "rgba(28, 24, 38, 0.72)", "$type": "color", "$description": "neutral.900 @ 72%" }
        },
        "text": {
          "primary":   { "$value": "#f4f2fa", "$type": "color" },
          "secondary": { "$value": "{color.neutral.400}", "$type": "color" },
