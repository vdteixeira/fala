        },
        "accent": {
          "default":  { "$value": "{color.violet.400}", "$type": "color" },
          "hover":    { "$value": "{color.violet.300}", "$type": "color" },
          "active":   { "$value": "{color.violet.200}", "$type": "color" },
          "soft":     { "$value": "rgba(138, 120, 236, 0.18)", "$type": "color", "$description": "violet.400 @ 18%" },
          "warm":     { "$value": "{color.amber.400}", "$type": "color" },
          "warmSoft": { "$value": "rgba(252, 166, 78, 0.16)", "$type": "color", "$description": "amber.400 @ 16%" }
        },
        "border": {
          "default": { "$value": "{color.neutral.800}", "$type": "color" },
