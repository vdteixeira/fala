      "shadow": {
        "sm":  { "$value": { "color": "rgba(0,0,0,0.3)", "offsetX": "0px", "offsetY": "1px",  "blur": "2px",  "spread": "0px" }, "$type": "shadow" },
        "md":  { "$value": { "color": "rgba(0,0,0,0.4)", "offsetX": "0px", "offsetY": "2px",  "blur": "8px",  "spread": "0px" }, "$type": "shadow" },
        "lg":  { "$value": { "color": "rgba(0,0,0,0.5)", "offsetX": "0px", "offsetY": "8px",  "blur": "24px", "spread": "0px" }, "$type": "shadow" },
        "pop": { "$value": { "color": "rgba(0,0,0,0.6)", "offsetX": "0px", "offsetY": "12px", "blur": "40px", "spread": "0px" }, "$type": "shadow" }
