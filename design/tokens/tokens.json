{
  "$description": "Fala — design tokens (DTCG). Source of truth mirrors fala-tokens.css exactly. Convention for modes: DTCG has no standard multi-mode, so semantic aliases are expressed as TWO parallel groups — semantic.light.* and semantic.dark.* — with identical leaf names; resolve one group per appearance (maps 1:1 to the data-theme='light|dark' blocks in fala-tokens.css). CSS mapping: --fala-<family>-<step> = color.<family>.<step> · --color-<group>-<name> = semantic.<mode>.color.<group>.<name> (kebab → dot, e.g. --color-bg-surface-hover = semantic.light.color.bg.surfaceHover; --color-state-recording-soft = semantic.<mode>.color.state.recordingSoft) · --space-N = space.N · --radius-N = radius.N · --text-<level>-{size,line,weight} = type.<level>.{size,lineHeight,weight} · --font-family-X = fontFamily.X · --shadow-N = semantic.<mode>.shadow.N · --motion-X = motion.duration.X · --ease-X = motion.easing.X.",
  "color": {
    "violet": {
      "$description": "Brand — trust/vault violet",
      "50":  { "$value": "#f2f0fd", "$type": "color" },
      "100": { "$value": "#e5e0fb", "$type": "color" },
      "200": { "$value": "#cdc4f6", "$type": "color" },
      "300": { "$value": "#ab9df0", "$type": "color" },
      "400": { "$value": "#8a78ec", "$type": "color" },
      "500": { "$value": "#6c5ce7", "$type": "color" },
      "600": { "$value": "#5341cd", "$type": "color" },
      "700": { "$value": "#4233a6", "$type": "color" },
      "800": { "$value": "#322579", "$type": "color" },
      "900": { "$value": "#221a52", "$type": "color" }
    },
    "amber": {
      "$description": "Warm accent — Brazilian warmth",
      "50":  { "$value": "#fff6ea", "$type": "color" },
      "100": { "$value": "#ffead0", "$type": "color" },
      "200": { "$value": "#ffd9a8", "$type": "color" },
      "300": { "$value": "#ffc077", "$type": "color" },
      "400": { "$value": "#fca64e", "$type": "color" },
      "500": { "$value": "#f28c26", "$type": "color" },
      "600": { "$value": "#d0731a", "$type": "color" },
      "700": { "$value": "#a55a12", "$type": "color" }
    },
    "neutral": {
      "$description": "Plum-tinted neutrals",
      "0":   { "$value": "#ffffff", "$type": "color" },
      "50":  { "$value": "#f7f6fa", "$type": "color" },
      "100": { "$value": "#efedf4", "$type": "color" },
      "200": { "$value": "#e3e0ea", "$type": "color" },
      "300": { "$value": "#cbc7d6", "$type": "color" },
      "400": { "$value": "#a5a0b1", "$type": "color" },
      "500": { "$value": "#7d7889", "$type": "color" },
      "600": { "$value": "#5e5969", "$type": "color" },
      "700": { "$value": "#46414f", "$type": "color" },
      "800": { "$value": "#302b3a", "$type": "color" },
      "850": { "$value": "#262130", "$type": "color" },
      "900": { "$value": "#1c1826", "$type": "color" },
      "950": { "$value": "#141019", "$type": "color" }
    },
    "green": {
      "$description": "Success",
      "100": { "$value": "#d9f4e5", "$type": "color" },
      "300": { "$value": "#6fd8a3", "$type": "color" },
      "400": { "$value": "#43c583", "$type": "color" },
      "500": { "$value": "#27b06b", "$type": "color" },
      "600": { "$value": "#1e9159", "$type": "color" }
    },
    "rose": {
      "$description": "Recording — live, pulsing",
      "100": { "$value": "#ffe0ea", "$type": "color" },
      "300": { "$value": "#ff9ab8", "$type": "color" },
      "400": { "$value": "#ff6b93", "$type": "color" },
      "500": { "$value": "#f43f6e", "$type": "color" },
      "600": { "$value": "#d02a58", "$type": "color" }
    },
    "red": {
      "$description": "Error — firm",
      "100": { "$value": "#ffdfdf", "$type": "color" },
      "300": { "$value": "#ff8f8f", "$type": "color" },
      "400": { "$value": "#ff6b78", "$type": "color" },
      "500": { "$value": "#e0404c", "$type": "color" },
      "600": { "$value": "#c22c3c", "$type": "color" }
    }
  },
  "space": {
    "$description": "8px grid; 05 (4px) only for tight icon/text gaps",
    "05": { "$value": "4px",  "$type": "dimension" },
    "1":  { "$value": "8px",  "$type": "dimension" },
    "2":  { "$value": "16px", "$type": "dimension" },
    "3":  { "$value": "24px", "$type": "dimension" },
    "4":  { "$value": "32px", "$type": "dimension" },
    "5":  { "$value": "40px", "$type": "dimension" },
    "6":  { "$value": "48px", "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "6px",   "$type": "dimension" },
    "md":   { "$value": "10px",  "$type": "dimension" },
    "lg":   { "$value": "14px",  "$type": "dimension" },
    "xl":   { "$value": "20px",  "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "fontFamily": {
    "ui":      { "$value": ["-apple-system", "BlinkMacSystemFont", "SF Pro Text", "system-ui", "sans-serif"], "$type": "fontFamily" },
    "display": { "$value": ["Plus Jakarta Sans", "-apple-system", "BlinkMacSystemFont", "system-ui", "sans-serif"], "$type": "fontFamily" },
    "mono":    { "$value": ["ui-monospace", "SF Mono", "Menlo", "monospace"], "$type": "fontFamily" }
  },
  "type": {
    "$description": "SwiftUI: ui≈SF Pro Text, display=Plus Jakarta Sans, mono≈SF Mono",
    "display":  { "size": { "$value": "26px", "$type": "dimension" }, "lineHeight": { "$value": "32px", "$type": "dimension" }, "weight": { "$value": 700, "$type": "fontWeight" } },
    "title":    { "size": { "$value": "17px", "$type": "dimension" }, "lineHeight": { "$value": "22px", "$type": "dimension" }, "weight": { "$value": 700, "$type": "fontWeight" } },
    "headline": { "size": { "$value": "13px", "$type": "dimension" }, "lineHeight": { "$value": "18px", "$type": "dimension" }, "weight": { "$value": 600, "$type": "fontWeight" } },
    "body":     { "size": { "$value": "13px", "$type": "dimension" }, "lineHeight": { "$value": "18px", "$type": "dimension" }, "weight": { "$value": 400, "$type": "fontWeight" } },
    "caption":  { "size": { "$value": "11px", "$type": "dimension" }, "lineHeight": { "$value": "14px", "$type": "dimension" }, "weight": { "$value": 500, "$type": "fontWeight" } },
    "micro":    { "size": { "$value": "10px", "$type": "dimension" }, "lineHeight": { "$value": "12px", "$type": "dimension" }, "weight": { "$value": 600, "$type": "fontWeight" } }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration", "$description": "hovers, toggles, icon swaps" },
      "base": { "$value": "200ms", "$type": "duration", "$description": "surfaces, badges, focus ring, progress width, dismiss" },
      "slow": { "$value": "320ms", "$type": "duration", "$description": "pill/popover enter, theme cross-fade" }
    },
    "easing": {
      "standard": { "$value": [0.2, 0, 0, 1],     "$type": "cubicBezier", "$description": "general deceleration" },
      "spring":   { "$value": [0.34, 1.4, 0.64, 1], "$type": "cubicBezier", "$description": "character moments: pill enter, toggle knob" }
    }
  },
  "semantic": {
    "light": {
      "color": {
        "bg": {
          "canvas":       { "$value": "{color.neutral.50}",  "$type": "color" },
          "surface":      { "$value": "{color.neutral.0}",   "$type": "color" },
          "surfaceHover": { "$value": "{color.neutral.100}", "$type": "color" },
          "inset":        { "$value": "{color.neutral.100}", "$type": "color" },
          "vibrancy":     { "$value": "rgba(247, 246, 250, 0.78)", "$type": "color", "$description": "neutral.50 @ 78% — NSVisualEffectView .menu" }
        },
        "text": {
          "primary":   { "$value": "{color.neutral.900}", "$type": "color" },
          "secondary": { "$value": "{color.neutral.600}", "$type": "color" },
          "tertiary":  { "$value": "{color.neutral.400}", "$type": "color" },
          "onAccent":  { "$value": "#ffffff", "$type": "color" }
        },
        "accent": {
          "default":  { "$value": "{color.violet.600}", "$type": "color" },
          "hover":    { "$value": "{color.violet.700}", "$type": "color" },
          "active":   { "$value": "{color.violet.800}", "$type": "color" },
          "soft":     { "$value": "{color.violet.100}", "$type": "color" },
          "warm":     { "$value": "{color.amber.500}",  "$type": "color" },
          "warmSoft": { "$value": "{color.amber.100}",  "$type": "color" }
        },
        "border": {
          "default": { "$value": "{color.neutral.200}", "$type": "color" },
          "strong":  { "$value": "{color.neutral.300}", "$type": "color" }
        },
        "focusRing": { "$value": "rgba(83, 65, 205, 0.4)", "$type": "color", "$description": "violet.600 @ 40%" },
        "state": {
          "idle":             { "$value": "{color.neutral.500}", "$type": "color" },
          "idleSoft":         { "$value": "{color.neutral.100}", "$type": "color" },
          "recording":        { "$value": "{color.rose.500}",    "$type": "color" },
          "recordingSoft":    { "$value": "{color.rose.100}",    "$type": "color" },
          "transcribing":     { "$value": "{color.violet.500}",  "$type": "color" },
          "transcribingSoft": { "$value": "{color.violet.100}",  "$type": "color" },
          "success":          { "$value": "{color.green.600}",   "$type": "color" },
          "successSoft":      { "$value": "{color.green.100}",   "$type": "color" },
          "error":            { "$value": "{color.red.500}",     "$type": "color" },
          "errorSoft":        { "$value": "{color.red.100}",     "$type": "color" },
          "warning":          { "$value": "{color.amber.600}",   "$type": "color" },
          "warningSoft":      { "$value": "{color.amber.100}",   "$type": "color" }
        },
        "pill": {
          "bg":   { "$value": "rgba(28, 24, 38, 0.88)", "$type": "color", "$description": "neutral.900 @ 88% — HUD is dark in both appearances" },
          "text": { "$value": "#f4f2fa", "$type": "color" }
        }
      },
      "shadow": {
        "sm":  { "$value": { "color": "rgba(28,24,38,0.06)", "offsetX": "0px", "offsetY": "1px",  "blur": "2px",  "spread": "0px" }, "$type": "shadow" },
        "md":  { "$value": { "color": "rgba(28,24,38,0.08)", "offsetX": "0px", "offsetY": "2px",  "blur": "8px",  "spread": "0px" }, "$type": "shadow" },
        "lg":  { "$value": { "color": "rgba(28,24,38,0.12)", "offsetX": "0px", "offsetY": "8px",  "blur": "24px", "spread": "0px" }, "$type": "shadow" },
        "pop": { "$value": { "color": "rgba(34,26,82,0.18)", "offsetX": "0px", "offsetY": "12px", "blur": "40px", "spread": "0px" }, "$type": "shadow" }
      }
    },
    "dark": {
