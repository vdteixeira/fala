          "idleSoft":         { "$value": "{color.neutral.850}", "$type": "color" },
          "recording":        { "$value": "{color.rose.400}",    "$type": "color" },
          "recordingSoft":    { "$value": "rgba(255, 107, 147, 0.16)", "$type": "color", "$description": "rose.400 @ 16%" },
          "transcribing":     { "$value": "{color.violet.300}",  "$type": "color" },
          "transcribingSoft": { "$value": "rgba(171, 157, 240, 0.16)", "$type": "color", "$description": "violet.300 @ 16%" },
          "success":          { "$value": "{color.green.400}",   "$type": "color" },
